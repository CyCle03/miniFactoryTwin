# MQTT transport
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_STATE_TOPIC=factory/machine/state
MQTT_COMMAND_TOPIC=factory/machine/command
MQTT_EVENT_TOPIC=factory/machine/event

# Simulator
SIM_TICK_RATE=20
SIM_PUBLISH_RATE=10
SIM_GOOD_RATE=0.95

# Optional inspection mode: disabled, images, or yolo
VISION_MODE=disabled
VISION_IMAGE_DIR=/app/inspection-images
VISION_MIN_CONFIDENCE=0.7
VISION_TIMEOUT=1.0
VISION_MODEL_PATH=/app/models/best.pt
VISION_GOOD_CLASSES=good

# Backend state source: mqtt or modbus
DATA_SOURCE=mqtt
DATABASE_PATH=./data/minifactory.db

# Modbus adapter (used when DATA_SOURCE=modbus)
MODBUS_HOST=modbus-simulator
MODBUS_PORT=5020
MODBUS_UNIT_ID=1
MODBUS_POLL_INTERVAL=0.1
MODBUS_STALE_TIMEOUT=2.0
MODBUS_COMMAND_TIMEOUT=2.0

# Development only: bypass MQTT and run the Python simulator inside FastAPI.
LOCAL_SIMULATION=false
